*{box-sizing:border-box}body{margin:0;background:#f4f6fb;color:#172033;font:16px/1.6 system-ui,-apple-system,Segoe UI,sans-serif}header{background:#0b1d3a;color:white;padding:16px max(18px,calc((100% - 1000px)/2));display:flex;gap:20px;justify-content:space-between;align-items:center;flex-wrap:wrap}.brand{font-size:20px;font-weight:800;color:white;text-decoration:none}.brand span{font-size:13px;color:#b8c8e7;display:block}nav{display:flex;gap:14px;flex-wrap:wrap}nav a{color:white;text-decoration:none;font-size:14px}main{max-width:1000px;margin:24px auto;padding:0 16px;min-height:70vh}.hero{background:#102a52;color:white;border-radius:18px;padding:32px 24px;margin-bottom:28px}.hero h1{font-size:clamp(28px,6vw,44px);line-height:1.1;margin:8px 0 14px}.eyebrow{letter-spacing:2px;font-size:12px;color:#b8c8e7}.button,button{display:inline-block;border:0;border-radius:9px;background:#155eef;color:white;padding:11px 16px;text-decoration:none;font-weight:700;font-size:14px;cursor:pointer}.jobs{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:16px}.job{background:white;border:1px solid #e1e6ef;border-radius:14px;padding:18px;margin:12px 0;box-shadow:0 3px 12px #102a5208}.job h2{margin:6px 0;font-size:21px}.job small{color:#58677f}.job p{overflow-wrap:anywhere}.job .button{margin-top:6px}form{max-width:620px;background:white;padding:20px;border-radius:14px;margin:16px 0;border:1px solid #e1e6ef}label{display:block;font-weight:650;margin:12px 0}input,textarea{display:block;width:100%;margin-top:6px;padding:12px;border:1px solid #cbd4e2;border-radius:8px;font:inherit}textarea{min-height:120px;resize:vertical}.secondary{background:#596579}.danger{background:#a32335}.actions{display:flex;gap:8px;flex-wrap:wrap}.actions form{padding:0;border:0;margin:0;background:transparent}.actions button{font-size:12px;padding:9px 10px}.split{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}footer{text-align:center;padding:24px 16px;color:#69758a;font-size:13px}@media(max-width:600px){header{align-items:flex-start;flex-direction:column}.hero{padding:26px 18px}}
